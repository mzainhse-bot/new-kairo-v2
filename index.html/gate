<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>New Kairo</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
body{font-family:sans-serif;background:#111;color:#fff;text-align:center;padding:20px}
input,button{padding:12px;margin:5px;width:90%;max-width:300px;border-radius:10px;border:none}
button{background:#25D366;color:#000;font-weight:bold;cursor:pointer}
.card{background:#222;padding:15px;border-radius:15px;margin:10px auto;max-width:350px}
.user{display:flex;justify-content:space-between;background:#333;padding:10px;border-radius:10px;margin:5px}
.del{background:red;color:#fff;width:auto;padding:5px 10px}
</style>
</head>
<body>
<h1>New Kairo ✨</h1>
<p>تسجيل = دخول على طول، مفيش موافقة</p>
<div id="auth" class="card">
<input id="name" placeholder="اسمك">
<input id="email" placeholder="الايميل">
<input id="password" type="password" placeholder="الباسورد">
<br>
<button onclick="signup()">عمل حساب جديد</button>
<button onclick="login()">دخول</button>
<p id="msg"></p>
</div>
<div id="home" class="card" style="display:none">
<h2 id="welcome"></h2>
<p>انت دخلت بنجاح ✅</p>
<div id="adminBox" style="display:none">
<h3>كل الأعضاء (للمدير بس)</h3>
<div id="users"></div>
</div>
<button onclick="logout()">خروج</button>
</div>
<script>
const SUPABASE_URL = "PASTE_URL_HERE";
const SUPABASE_KEY = "PASTE_ANON_KEY_HERE";
const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
async function signup(){
  const email=document.getElementById('email').value;
  const password=document.getElementById('password').value;
  const name=document.getElementById('name').value;
  const {data,error}=await supabaseClient.auth.signUp({email,password});
  if(error){document.getElementById('msg').innerText=error.message;return;}
  let userId = data.user?.id;
  if(!userId){
    const {data:loginData}=await supabaseClient.auth.signInWithPassword({email,password});
    userId=loginData.user?.id;
  }
  if(userId){
    await supabaseClient.from('app_users').insert([{id:userId,email:email,name:name,role:'user'}]);
  }
  document.getElementById('msg').innerText="تم عمل الحساب! دخلت على طول ✅";
  checkUser();
}
async function login(){
  const email=document.getElementById('email').value;
  const password=document.getElementById('password').value;
  const {error}=await supabaseClient.auth.signInWithPassword({email,password});
  if(error){document.getElementById('msg').innerText=error.message;return;}
  checkUser();
}
async function checkUser(){
  const {data:{user}}=await supabaseClient.auth.getUser();
  if(!user) return;
  document.getElementById('auth').style.display='none';
  document.getElementById('home').style.display='block';
  const {data:profile}=await supabaseClient.from('app_users').select('*').eq('id',user.id).single();
  const name = profile?.name || user.email;
  document.getElementById('welcome').innerText="أهلا "+name;
  if(profile?.role==='admin'){
    document.getElementById('adminBox').style.display='block';
    loadUsers();
  }
}
async function loadUsers(){
  const {data}=await supabaseClient.from('app_users').select('*').order('created_at');
  document.getElementById('users').innerHTML=data.map(u=>`
    <div class="user"><span>${u.name||''} - ${u.email} (${u.role})</span><button class="del" onclick="deleteUser('${u.id}')">مسح</button></div>
  `).join('');
}
async function deleteUser(id){
  if(!confirm('متأكد تمسحه؟')) return;
  await supabaseClient.from('app_users').delete().eq('id',id);
  loadUsers();
}
async function logout(){
  await supabaseClient.auth.signOut();
  location.reload();
}
checkUser();
</script>
</body>
</html>
